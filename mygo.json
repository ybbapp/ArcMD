{
  "name": "ArcMD",
  "slug": "arcmd",
  "identifier": "org.ybbapp.arcmd",
  "version": "0.2.12",
  "license": "MIT",
  "icon": "resources/icon.png",
  "main": "./cmd/arcmd",
  "out": "dist",
  "resources": [
    "LICENSE",
    "third_party"
  ],
  "fileAssociations": [
    {
      "ext": [
        "md",
        "markdown",
        "mdx"
      ],
      "name": "Markdown Document",
      "mimeType": "text/markdown",
      "role": "Editor"
    },
    {
      "ext": [
        "arcmd"
      ],
      "name": "ArcMD Document",
      "mimeType": "application/x-arcmd",
      "role": "Editor"
    }
  ],
  "macos": {
    "icon": "resources/icon.icns"
  },
  "linux": {
    "webview": false,
    "comment": "Native Markdown and rich-text editor",
    "categories": ["Office"],
    "command": "arcmd",
    "depends": {
      "arch": ["hicolor-icon-theme", "poppler-glib"]
    }
  }
}
